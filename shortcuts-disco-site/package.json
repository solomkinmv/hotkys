{
  "name": "shortcuts-disco-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run export-data && npm run optimize-images && next build",
    "lint": "eslint .",
    "test": "jest",
    "test:rls": "node --test supabase/tests/oauth-rls.test.mjs supabase/tests/overlay-quota.test.mjs supabase/tests/private-apps.test.mjs supabase/tests/windows-identifiers.test.mjs",
    "export-data": "node --import tsx ./src/lib/write/app-writer.ts",
    "optimize-images": "node --import tsx ./src/lib/write/optimize-images.ts",
    "prettify": "node --import tsx ./src/lib/write/prettify.ts",
    "test:types": "tsc --noEmit",
    "validate-data": "node --import tsx ./src/lib/write/validate-data.ts",
    "format-data:check": "node --import tsx ./src/lib/write/prettify.ts --check",
    "test:db:concurrency": "node --test supabase/tests/concurrency.test.mjs",
    "check:config": "node --import tsx scripts/check-config.ts",
    "prebuild": "npm run check:config -- --mode auto",
    "predev": "npm run check:config -- --mode auto && npm run optimize-images",
    "test:catalog": "tsx --tsconfig tsconfig.json ../scripts/verify-catalog.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/react": "^6.17.5",
    "@next/third-parties": "^16.3.8",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.59.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@next/env": "^16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.17.1",
    "chokidar": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "pg": "^8.16.3",
    "postcss": "^8.5.28",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "eslint-config-next": {
      "eslint-plugin-react-hooks": "7.0.1"
    },
    "next": {
      "postcss": "$postcss"
    }
  }
}
