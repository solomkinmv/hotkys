{
  "$schema": "https://hotkys.com/schema/shortcut.schema.json",
  "name": "Claude Code Desktop",
  "slug": "claude-code-desktop",
  "source": "https://code.claude.com/docs/en/desktop#keyboard-shortcuts",
  "icon": "icons/claude.png",
  "keymaps": [
    {
      "title": "macOS",
      "platforms": [
        "macos"
      ],
      "sections": [
        {
          "title": "Sessions",
          "shortcuts": [
            {
              "title": "Show keyboard shortcuts",
              "key": "cmd+/"
            },
            {
              "title": "New session",
              "key": "cmd+n"
            },
            {
              "title": "Close session",
              "key": "cmd+w"
            },
            {
              "title": "Next session",
              "key": "ctrl+tab"
            },
            {
              "title": "Previous session",
              "key": "ctrl+shift+tab"
            },
            {
              "title": "Next session",
              "key": "shift+cmd+]"
            },
            {
              "title": "Previous session",
              "key": "shift+cmd+["
            },
            {
              "title": "Send prompt",
              "key": "enter",
              "comment": "When the prompt box is focused"
            },
            {
              "title": "Stop Claude's response",
              "key": "esc"
            },
            {
              "title": "Open side chat",
              "key": "cmd+;"
            }
          ]
        },
        {
          "title": "Workspace and review",
          "shortcuts": [
            {
              "title": "Toggle diff pane",
              "key": "shift+cmd+d"
            },
            {
              "title": "Toggle Browser pane",
              "key": "shift+cmd+b"
            },
            {
              "title": "Select element in Browser",
              "key": "shift+cmd+s"
            },
            {
              "title": "Toggle terminal pane",
              "key": "ctrl+`",
              "comment": "Local sessions only"
            },
            {
              "title": "Close focused pane",
              "key": "cmd+\\"
            },
            {
              "title": "Cycle view modes",
              "key": "ctrl+o"
            },
            {
              "title": "Add diff comment",
              "key": "enter",
              "comment": "When a diff comment box is focused"
            },
            {
              "title": "Submit all diff comments",
              "key": "cmd+enter",
              "comment": "In the diff viewer"
            }
          ]
        },
